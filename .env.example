APP_NAME=LONGOS
APP_ENV=production
APP_KEY=
# Comma-separated retired APP_KEY values used only for decrypting existing
# encrypted records during key rotation. Never remove a key until all records
# depending on it have been re-encrypted or retired.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=
APP_TIMEZONE=Asia/Shanghai
LONGOS_CHECKOUT_LOCALE=en
APP_FORCE_HTTPS=false
LONGOS_PRODUCT_NAME=LONGOS
LONGOS_PRODUCT_EDITION="LONGOS Commerce SaaS"
LONGOS_OWNER=LONGOS
LONGOS_TAGLINE="One platform. Every storefront."
LONGOS_AUTO_UPGRADE=false
LONGOS_UPGRADE_SETTLE_SECONDS=15
LONGOS_UPDATER_ENABLED=false
# GitHub owner/repository. It can also be configured from the root-admin UI.
LONGOS_UPDATE_REPOSITORY=
LONGOS_UPDATE_CHANNEL=stable
LONGOS_UPDATE_ASSET=longos-release.zip
LONGOS_UPDATE_MAX_BYTES=1073741824
LONGOS_UPDATE_MAX_FILES=100000
LONGOS_UPDATE_COMMAND_TIMEOUT=3600
LONGOS_UPDATE_QUEUED_STALE_SECONDS=600
LONGOS_UPDATE_REQUEST_DRAIN_SECONDS=5
LONGOS_UPDATE_QUEUE_DRAIN_SECONDS=300
LONGOS_PSQL_PATH=
LONGOS_PHP_CLI_PATH=
LONGOS_UPDATE_RETAIN_BACKUPS=3
# Optional database client overrides for maintenance jobs.
LONGOS_MYSQLDUMP_PATH=
LONGOS_MYSQL_PATH=
LONGOS_PG_DUMP_PATH=
LONGOS_PG_RESTORE_PATH=
LONGOS_TRUSTED_PROXIES=
LONGOS_PROXY_TOKEN=
# Non-secret edge identity. Coolify generates and preserves it.
LONGOS_EDGE_ID=
LONGOS_DEPLOYMENT_PLATFORM=coolify
LONGOS_ORDER_ACCESS_LINK_DAYS=30
LONGOS_PAYMENT_ACTION_LINK_MINUTES=180
LONGOS_REMOTE_IMAGE_MAX_BYTES=10485760

# Coolify deployment identity. Public 80/443 belong to Coolify's integrated
# Caddy proxy; LONGOS containers never publish host ports.
DOMAIN=
SAAS_TLS_EMAIL=
# Migration only: set this to the complete APP_KEY from the old deployment.
# Leave blank for a new site so Coolify generates and preserves the key.
APP_KEY_OVERRIDE=

# Built-in outbound mail engine. Coolify Compose starts this Postfix +
# OpenDKIM service automatically; it is not exposed as a public SMTP relay.
LONGOS_MAIL_RELAY_ENABLED=false
MAIL_RELAY_HOST=mail-relay
MAIL_RELAY_PORT=25
# Default: bundled relay on the private Compose network. Optional dedicated
# egress node: https://relay-api.example.com (no trailing /v1/send). The remote
# node must run longos-cloud-mail/mail-relay with the same two HMAC secrets.
MAIL_RELAY_ENDPOINT=http://mail-relay:3000
# Optional path for the control-site visual topology override. Keep it inside
# the shared Laravel storage volume so app, worker and scheduler see one value.
MAIL_RELAY_RUNTIME_SETTINGS_PATH=/var/www/html/storage/app/longos/mail-relay-runtime.json
# Compose derives these values. If an older deployment leaves them
# blank, LONGOS and Compose derive the platform signing domain from
# SAAS_BASE_DOMAIN (falling back to DOMAIN/APP_URL).
MAIL_RELAY_HOSTNAME=
# Comma-separated signing domains. Every tenant-specific From domain must be
# present in both lists before the control site can assign it to a child site.
MAIL_RELAY_DOMAINS=
MAIL_RELAY_ALLOWED_SENDER_DOMAINS=
# Shared fallback only. Child sites with an assigned domain prefer their own
# identity while continuing to use the one control-site integration token.
MAIL_RELAY_PLATFORM_SENDER_DOMAIN=
# Separate HMAC credentials: never reuse one value for both clients.
# Internal HMAC credentials are generated by Coolify magic variables. Do not
# expose either value to Cloudflare or GitHub. Cloud Mail uses LONGOS_INTEGRATION_TOKEN,
# created from the LONGOS admin System Integration Tokens page.
MAIL_RELAY_SHARED_SECRET=
CLOUD_MAIL_RELAY_SHARED_SECRET=
MAIL_RELAY_PUBLIC_URL=
# Optional public IP override for dedicated SMTP egress, unusual NAT or policy
# routing. Leave blank for quorum-based server-side auto-detection. This is not
# a website/Caddy target and Cloudflare Anycast DNS is never used as the source.
MAIL_RELAY_IPS=
MAIL_RELAY_AUTO_DETECT_IPS=true
# 32 MiB leaves enough room for a 20 MiB attachment after Base64 expansion
# plus the JSON/message envelope. The former 25 MiB default is migrated by
# the bundled relay entrypoint for existing Coolify resources.
MAIL_RELAY_MAX_REQUEST_BYTES=33554432
MAIL_RELAY_MAX_ATTACHMENT_BYTES=20971520
MAIL_RELAY_MAX_ATTACHMENTS=25
MAIL_RELAY_MAX_RECIPIENTS=50
MAIL_RELAY_DKIM_SELECTOR=mail2026
MAIL_RELAY_MAX_REQUESTS_PER_MINUTE=120
MAIL_RELAY_MAX_REQUESTS_PER_MINUTE_GLOBAL=1200
MAIL_RELAY_MAX_NONCE_RECORDS=12000
MAIL_RELAY_SIGNATURE_WINDOW_SECONDS=300
# Must be at least twice MAIL_RELAY_SIGNATURE_WINDOW_SECONDS (default 300).
MAIL_RELAY_IDEMPOTENCY_RETENTION_SECONDS=86400
MAIL_RELAY_MAX_IDEMPOTENCY_RECORDS=100000
MAIL_RELAY_MAX_QUEUE_MESSAGES=1000
MAIL_RELAY_PROCESS_CHECK_INTERVAL_SECONDS=5

# TEST-only checkout diagnostics. Leave disabled on real tenant storefronts.
BEIKESHOP_TEST_CHECKOUT_TAKEOVER=false
# Optional scoped token used by LONGOS DNS automation. Coolify Caddy obtains
# exact-domain certificates through On-Demand TLS and does not require it.
CLOUDFLARE_API_TOKEN_FILE=
# Optional fallback for LONGOS-side button/scheduler. Integrated Cloud Mail
# deployment passes its scoped GitHub token for one sync and does not persist it.
CLOUDFLARE_API_TOKEN=
LONGOS_CLOUDFLARE_MODE=optional
# With a scoped Zone:Read + DNS:Edit token for every signing zone, publish DKIM,
# merge SPF into one policy, and add missing DMARC. MAIL_RELAY_HOSTNAME A/AAAA is
# also maintained from explicit MAIL_RELAY_IPS or the safely auto-detected IP.
LONGOS_AUTO_CONFIGURE_MAIL_DNS=true
# Normally leave blank; primarily useful for immutable/read-only deployments.
CLOUDFLARE_IP_RANGES_PATH=
DB_ROOT_PASSWORD=

# LONGOS trusts this country header only after Caddy proves the immediate edge
# peer belongs to Cloudflare's official ranges. The range cache refreshes daily.
# The Cloudflare zone must enable IP Geolocation / visitor location headers.
CURRENCY_TRUST_CDN_COUNTRY_HEADERS=true
# Optional offline fallback when the domain does not pass through Cloudflare.
# CURRENCY_GEOLITE2_PATH=/absolute/path/to/GeoLite2-Country.mmdb
# Reject unexpectedly incomplete provider responses before replacing snapshots.
CURRENCY_MINIMUM_RATE_COUNT=100

LOG_CHANNEL=stack
LOG_LEVEL=warning
PHP_WORKER_MEMORY_LIMIT=512M
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=longos
DB_USERNAME=longos
DB_PASSWORD=

# Multi-site SaaS mode. Run `php artisan saas:install` before enabling it.
SAAS_ENABLED=false
# prefix (default): one database account with isolated tenant table prefixes.
# database: one physical database per tenant; requires a provisioning account.
SAAS_DATABASE_MODE=prefix
# Optional in prefix mode. Leave blank to reuse DB_DATABASE.
SAAS_SHARED_DATABASE=
# Optional dedicated control DB. Leave blank to reuse DB_*.
SAAS_DB_CONNECTION=
SAAS_DB_HOST=
SAAS_DB_PORT=
SAAS_DB_DATABASE=
SAAS_DB_USERNAME=
SAAS_DB_PASSWORD=
# Optional tenant database server. Blank values inherit DB_* and keep tenant
# databases on the existing application database server.
SAAS_TENANT_DB_CONNECTION=
SAAS_TENANT_DB_HOST=
SAAS_TENANT_DB_PORT=
SAAS_TENANT_DB_USERNAME=
SAAS_TENANT_DB_PASSWORD=
# MySQL account host used when tenant_admin grants a newly created database
# to the shared tenant runtime account. It must match the pre-created account.
SAAS_TENANT_DB_GRANT_HOST=%
SAAS_TENANT_ADMIN_HOST=
SAAS_TENANT_ADMIN_PORT=
SAAS_TENANT_ADMIN_DATABASE=
SAAS_TENANT_ADMIN_USERNAME=
SAAS_TENANT_ADMIN_PASSWORD=
SAAS_BASE_DOMAIN=
SAAS_DATABASE_PREFIX=longos_
SAAS_DEFAULT_SCHEME=https
SAAS_REJECT_UNKNOWN_DOMAINS=true
SAAS_MAX_BATCH_SIZE=100
SAAS_CONTROL_DOMAINS=
SAAS_HTTP_MANAGEMENT=false
SAAS_ISOLATE_FILES=true
SAAS_CUSTOM_DOMAINS_ENABLED=true
SAAS_CUSTOM_DOMAINS_MAX_PER_SITE=10
SAAS_DOMAIN_VERIFICATION_TTL_HOURS=72
SAAS_DOMAIN_VERIFICATION_RETRY_MINUTES=15
SAAS_DOMAIN_VERIFICATION_BATCH=100
# Shopify-style domain roles. Secondary storefront domains redirect to the
# primary domain by default; admin/API/installer paths remain available as a
# recovery channel on every active domain.
SAAS_REDIRECT_SECONDARY_DOMAINS=true
SAAS_PRIMARY_REDIRECT_STATUS=308
SAAS_PRIMARY_REDIRECT_EXEMPT_PATHS=api,installer
SAAS_RETAIN_PLATFORM_DOMAIN=true
SAAS_RESERVED_SUBDOMAINS=www,admin,api,app,mail,ftp,smtp,pop,imap,support,status,docs,cdn,static,assets,ns1,ns2
# Required for HTTP batch provisioning. Reusing the same UUID and payload
# safely replays the encrypted stored response for 24 hours.
SAAS_REQUIRE_IDEMPOTENCY_KEY=true
SAAS_IDEMPOTENCY_TTL_HOURS=24
SAAS_IDEMPOTENCY_PROCESSING_TIMEOUT_MINUTES=120
SAAS_PROVISIONING_LEASE_TIMEOUT_MINUTES=120
# Web-based tenant creation runs migrations and seeders in PHP-FPM.
SAAS_PROVISIONING_MEMORY_LIMIT=512M
SAAS_PROVISIONING_MINIMUM_MEMORY_BYTES=268435456
SAAS_PROVISIONING_MAX_EXECUTION_SECONDS=0
# Required before tenant-owned custom domains can activate. Comma-separated
# public A/AAAA addresses or CNAME targets accepted as this LONGOS edge.
# Optional override. Blank reuses SAAS_CONTROL_DOMAINS as the trusted Caddy
# route; set origin IPs/hostnames only for a split edge topology.
SAAS_DNS_TARGETS=
# Real HTTPS publication probe timeouts. A custom domain remains pending until
# this Coolify deployment answers the signed probe through its Caddy edge.
SAAS_DOMAIN_PROBE_CONNECT_TIMEOUT=3
SAAS_DOMAIN_PROBE_TIMEOUT=8
# First Caddy access can include a complete ACME certificate order.
SAAS_CADDY_PROBE_TIMEOUT=45
SAAS_WEB_SERVER=caddy
SAAS_DOMAIN_CONFIG_PATH=
SAAS_DOMAIN_MANIFEST_PATH=
SAAS_DOMAIN_LOCK_TIMEOUT_SECONDS=10
SAAS_TLS_DRIVER=caddy
# Coolify Caddy manages both the control host and tenant certificates.
SAAS_TLS_EXTERNAL_CONTROL_DOMAIN=false
SAAS_TLS_EMAIL=
TRUST_HOSTS_ENABLED=true

CACHE_DRIVER=database
CACHE_DB_CONNECTION=
SESSION_DRIVER=file
# SaaS 会强制使用 Host-only Cookie，并为每个租户分配独立 Session
# 存储目录；请勿在生产环境设置可跨子域共享的 SESSION_DOMAIN。
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
QUEUE_DB_CONNECTION=saas
QUEUE_FAILED_DB_CONNECTION=saas
QUEUE_RETRY_AFTER=3900
FILESYSTEM_DRIVER=local

# Checkout address suggestions. The endpoint must be a public HTTPS Photon API.
# For sustained production traffic, point this to a self-hosted Photon instance.
CHECKOUT_ADDRESS_AUTOCOMPLETE=true
CHECKOUT_ADDRESS_AUTOCOMPLETE_URL=https://photon.komoot.io/api/
# Optional absolute CA bundle path for panel/manual PHP installations.
CHECKOUT_ADDRESS_CA_BUNDLE=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
# Docker one-click installation derives the signed address from
# SAAS_BASE_DOMAIN; external SMTP deployments may set this explicitly.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
